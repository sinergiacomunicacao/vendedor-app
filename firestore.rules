rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil existente e não excluído pelo gestor. get() falha (e a regra
    // nega) quando o perfil não existe, então isso cobre os dois casos.
    function contaAtiva() {
      return request.auth != null &&
        get(/databases/$(database)/documents/vendedores/$(request.auth.uid)).data.get("ativo", true) != false;
    }

    // Gestor excluído deixa de ser gestor.
    function isGestor() {
      return contaAtiva() &&
        get(/databases/$(database)/documents/vendedores/$(request.auth.uid)).data.papel == "gestor";
    }

    // Só o gestor grava a aprovação de desconto; o dono do cliente só pode
    // removê-la (o que acontece ao mudar prazo/desconto de um produto).
    function mexeNaAprovacao() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["descontoAprovadoEm", "descontoAprovadoPor", "descontoAprovadoPorId"]);
    }

    match /clientes/{clienteId} {
      allow read: if contaAtiva()
        && (request.auth.uid == resource.data.vendedorId || isGestor());
      allow delete: if contaAtiva()
        && (request.auth.uid == resource.data.vendedorId || isGestor());
      allow update: if contaAtiva()
        && (isGestor()
            || (request.auth.uid == resource.data.vendedorId
                && (!mexeNaAprovacao() || !("descontoAprovadoEm" in request.resource.data))));
      allow create: if contaAtiva()
        && request.auth.uid == request.resource.data.vendedorId
        && !("descontoAprovadoEm" in request.resource.data);
    }

    // Espelho minimalista de clientes (razão social, CNPJ, vendedor) —
    // legível por qualquer vendedor ativo, para evitar que dois vendedores
    // abordem a mesma empresa sem saber. Só os campos de criarCliente()/
    // atualizarCliente() ficam aqui, nunca telefone/email/produtos/valores.
    match /empresasAtendidas/{id} {
      allow read: if contaAtiva();
      allow create: if contaAtiva()
        && (request.auth.uid == request.resource.data.vendedorId || isGestor());
      allow update: if contaAtiva()
        && (request.auth.uid == resource.data.vendedorId || isGestor());
      allow delete: if isGestor();
    }

    // Ninguém muda o próprio papel nem se reativa: o próprio vendedor só
    // edita o perfil mantendo `papel` e `ativo` como estão. Só um gestor
    // altera `papel` e `ativo` (promover, excluir, reativar) — e sempre de
    // OUTRA pessoa, nunca de si mesmo.
    match /vendedores/{vendedorId} {
      allow read: if request.auth != null
        && (request.auth.uid == vendedorId || isGestor());
      allow create: if request.auth != null && request.auth.uid == vendedorId
        && request.resource.data.papel == "vendedor";
      allow update: if request.auth != null
        && ((request.auth.uid == vendedorId
             && request.resource.data.papel == resource.data.papel
             && request.resource.data.get("ativo", true) == resource.data.get("ativo", true))
            || (isGestor() && request.auth.uid != vendedorId
                && request.resource.data.papel in ["vendedor", "gestor"]));
    }

    // Comissões: só o gestor lê e escreve. Ficam fora de `clientes` e de
    // `vendedores` porque o vendedor lê os próprios clientes e edita o próprio
    // perfil — qualquer campo de comissão ali ficaria visível/editável por ele.
    match /comissoes/{clienteId} {
      allow read, write: if isGestor();
    }
    match /comissoesConfig/{vendedorId} {
      allow read, write: if isGestor();
    }

    // Visão da comissão de cada pessoa. O app do gestor grava uma linha por
    // contrato e beneficiário; cada vendedor só lê as linhas dele (a consulta
    // precisa filtrar por vendedorId).
    match /comissoesVendedor/{linhaId} {
      allow read: if contaAtiva()
        && (resource.data.vendedorId == request.auth.uid || isGestor());
      allow write: if isGestor();
    }

    match /prazosContrato/{prazoId} {
      allow read: if request.auth != null;
      allow write: if isGestor();
    }

    match /estabelecimentos/{estabelecimentoId} {
      allow read: if request.auth != null;
      allow write: if isGestor();

      match /produtos/{produtoId} {
        allow read: if request.auth != null;
        allow create, delete: if isGestor();
        allow update: if isGestor()
          || (contaAtiva()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estoque"]));
      }
    }
  }
}
