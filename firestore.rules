rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /clientes/{clienteId} {
      allow read, delete, update: if request.auth != null
        && request.auth.uid == resource.data.vendedorId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.vendedorId;
    }

    match /vendedores/{vendedorId} {
      allow read: if request.auth != null && request.auth.uid == vendedorId;
      allow create: if request.auth != null && request.auth.uid == vendedorId
        && request.resource.data.papel == "vendedor";
      allow update: if request.auth != null && request.auth.uid == vendedorId
        && request.resource.data.papel == resource.data.papel;
    }

    match /estabelecimentos/{estabelecimentoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == "lucascacaes@gmail.com";

      match /produtos/{produtoId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.auth.token.email == "lucascacaes@gmail.com";
      }
    }
  }
}
